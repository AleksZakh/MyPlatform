// Space tasks and projects — additive module, 2026-10-19.
model WorkProject {
  files WorkProjectFile[]
  groupId Int?
  group SpaceGroup? @relation(fields: [groupId], references: [id], onDelete: Restrict)
  invitations WorkProjectInvitation[]
  id Int @id @default(autoincrement())
  clientKey String @unique @db.Uuid
  name String @db.VarChar(200)
  description String @default("") @db.Text
  color String @default("#2563eb") @db.VarChar(7)
  scope String @default("PRIVATE") @db.VarChar(20)
  ownerId Int
  owner User @relation("WorkProjectOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  departmentId Int?
  department Department? @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  startDate DateTime? @db.Date
  dueDate DateTime? @db.Date
  archivedAt DateTime?
  version Int @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  members WorkProjectMember[]
  tasks WorkTask[]
  @@index([groupId, archivedAt])
  @@index([departmentId, archivedAt])
  @@index([ownerId])
  @@map("work_projects")
}
