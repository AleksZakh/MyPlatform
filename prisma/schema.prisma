

generator client {
  // provider = "prisma-client"
  provider = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
}

model sessions {
  id        Int    @id @default(autoincrement())
  userId    Int
  sessionId String @unique(map: "sessions_sessionid_unique") @db.VarChar(255)
  timestamp BigInt // Без кастинга
  users     users  @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "sessions_userid_foreign")

  @@index([sessionId], map: "idx_sessions_sessionId")
}

model users {
  id             Int              @id @default(autoincrement())
  userName       String           @unique(map: "users_username_unique") @db.VarChar(255)
  password       String           @db.VarChar(255)
  login          String           @unique @db.VarChar(255)
  email          String           @unique @db.VarChar(255)
  role           String           @db.VarChar(100)
  sessions       sessions[]

  @@index([userName], map: "idx_users_userName")
}

model AEng {
  id                      Int      @id @default(autoincrement())
  plp                     String   @db.VarChar(50)    // ПЛП
  objectName              String   @db.Text           // Наименование объекта
  samplingActNumber       String   @db.VarChar(100)   // Номер акта отбора проб
  samplingDate            DateTime @db.Date           // Дата отбора проб
  samplingPlace           String   @db.Text           // Место отбора проб
  personProvidedSample    String   @db.VarChar(255)   // Лицо, предоставившее пробу
  materialReceiptDate     DateTime? @db.Date           // Дата поступления материала
  materialName            String   @db.VarChar(255)   // Наименование материала
  
  // Старое поле (оставляем для обратной совместимости, чтобы старые данные не стерлись)
  qualityDocument         String   @db.VarChar(100)   // Документ о качестве (старое поле)

  // НАЧАЛО НОВЫХ ПОЛЕЙ (Все со знаком '?', чтобы миграция прошла успешно без потери данных)
  sDocPath                String?  @db.VarChar(255)   // Путь к файлу sDoc
  qualDocPath             String?  @db.VarChar(255)   // Путь к файлу qualDoc
  testDocPath             String?  @db.VarChar(255)  // Документ о качестве (новое имя) ✅ ПЕРЕИМЕНОВАНО
  protocolDocPath         String?  @db.VarChar(255)   // Путь к файлу protocolDoc
  qualDocNumber           String?  @db.VarChar(100)   // Номер документа о качестве из формы
  //================================

  // НОВЫЕ ПОЛЯ 28.07.2026
  qualDocDate             DateTime? @db.Date          // Дата документа о качестве
  authorEmail             String?   @db.VarChar(100) // Email автора
  editorEmail             String?   @db.VarChar(100) // Email редактора

  manufacturer            String?  @db.VarChar(255)   // Предприятие-изготовитель (может быть пустым)
  protocolNumber          String   @db.VarChar(100)   // Номер протокола
  protocolDate            DateTime? @db.Date           // Дата протокола
  testResult              String   @db.VarChar(100)   // Результат испытаний
  note                    String?  @db.Text           // Примечание (может быть пустым)
  createdAt               DateTime @default(now())

  @@map("aeng") // Название таблицы в PostgreSQL в нижнем регистре

  // Индексы
  @@index([samplingActNumber])
  @@index([protocolNumber])
}


