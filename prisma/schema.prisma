

generator client {
  // provider = "prisma-client"
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url = "postgresql://postgres:%21QAZxsw2@195.133.144.77:5432/NuxtTest"
}

model sessions {
  id        Int    @id @default(autoincrement())
  userId    Int
  sessionId String @unique(map: "sessions_sessionid_unique") @db.VarChar(255)
  timestamp BigInt // Без кастинга
  users     users  @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "sessions_userid_foreign")

  @@index([sessionId], map: "idx_sessions_sessionId")
}

model users {
  id             Int              @id @default(autoincrement())
  userName       String           @unique(map: "users_username_unique") @db.VarChar(255)
  password       String           @db.VarChar(255)
  login          String           @unique @db.VarChar(255)
  email          String           @unique @db.VarChar(255)
  role           String           @db.VarChar(100)
  sessions       sessions[]

  @@index([userName], map: "idx_users_userName")
}

model IncomControl {
  id                      Int      @id @default(autoincrement())
  plp                     String   @db.VarChar(50)    // ПЛП
  objectName              String   @db.Text           // Наименование объект
  samplingActNumber       String   @db.VarChar(100)   // Номер акта отбора проб
  samplingDate            DateTime @db.Date           // Дата отбора проб
  samplingLocation        String   @db.Text           // Место отбора проб
  providerPerson          String   @db.VarChar(255)   // Лицо, предоставившее пробу
  receivedDate            DateTime @db.Date           // Дата поступления материала
  materialName            String   @db.VarChar(255)   // Наименование материала
  qualityDocument         String   @db.VarChar(100)   // Документ о качестве
  manufacturer            String?  @db.VarChar(255)   // Предприятие-изготовитель (может быть пустым)
  protocolNumber          String   @db.VarChar(100)   // Номер протокола
  protocolDate            DateTime @db.Date           // Дата протокола
  testResult              String   @db.VarChar(100)   // Результат испытаний
  note                    String?  @db.Text           // Примечание (может быть пустым)
  createdAt               DateTime @default(now())

  @@map("incoming_control") // Название таблицы в PostgreSQL в нижнем регистре

  // Добавление одиночных индексов для ускорения поиска по каждому полю отдельно
  @@index([samplingActNumber])
  @@index([protocolNumber])
}


